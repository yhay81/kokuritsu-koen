{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kokuritsu-koen",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kokuritsu-koen.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["31 22 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kokuritsu-koen",
      "database_id": "86983c71-8b67-4d89-8e75-5486ad37f658",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
